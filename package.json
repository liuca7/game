{
  "name": "my-weird-semester",
  "version": "2.0.0",
  "description": "《我的奇葩一学期》网页版 - Cloudflare Workers 全栈文字冒险游戏",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute weird-semester --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute weird-semester --remote --file=./schema.sql",
    "test": "node test/smoke.cjs && node test/game.e2e.cjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "wrangler": "^4.16.0"
  }
}
